{
  "name": "conversation-display-kit",
  "version": "0.3.0",
  "description": "Accessible React conversations and reviewable agent actions",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/styles.css --format esm,cjs --dts --external react --sourcemap --clean",
    "lint": "eslint .",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo": "vite",
    "test:browser": "npm run build && playwright test",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "check": "npm run build && npm run lint && npm run typecheck && npm test && npm run test:browser && npm run test:package"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.4",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.3.0",
    "jsdom": "^30.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewodom18/conversation-display-kit.git"
  },
  "bugs": {
    "url": "https://github.com/andrewodom18/conversation-display-kit/issues"
  },
  "homepage": "https://github.com/andrewodom18/conversation-display-kit#readme",
  "keywords": [
    "react",
    "accessibility",
    "conversation",
    "agent",
    "human-in-the-loop"
  ]
}
